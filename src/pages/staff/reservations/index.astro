---
// src/pages/staff/reservations/index.astro
import Layout from "../../../layouts/Layout.astro";
import { ReservationsApp } from "../../../components/staff/ReservationsApp";

const title = "Reservations";
const description = "Staff table and reservation management.";
---

<Layout title={title} description={description} robots="noindex, nofollow">
  <main id="main-content" class="min-h-screen bg-[#F5EFE4] px-6 py-10 lg:px-12">
    <div class="mx-auto max-w-[1200px]">
      <ReservationsApp client:load />
    </div>
  </main>
</Layout>
